# ============================================
# Backend Environment Variables
# Copy this file to ".env" and fill real values
# NEVER commit the actual .env file to Git
# ============================================

PORT=5000

# Database connection (matches mysql-service K8s Service name)
DB_HOST=mysql-service
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=employeedb

# Node environment
NODE_ENV=production
